{
  "name": "tax-relief-status-checker",
  "version": "1.0.0",
  "description": "App for NJ residents to check the status of their property tax refund",
  "repository": "github:newjersey/tax-relief-status-checker",
  "homepage": "https://github.com/newjersey/tax-relief-status-checker#readme",
  "bugs": "https://github.com/newjersey/tax-relief-status-checker/issues",
  "scripts": {
    "dev": "cd webapp && next dev --port 3000",
    "build": "cd webapp && next build",
    "cypress": "cd webapp && cypress run",
    "package": "cd lambda && npm run package",
    "deploy:dev": "npm run package && cd infra && cdk deploy -c stage=dev",
    "deploy:prod": "npm run package && cd infra && cdk deploy -c stage=prod",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "lockfile": "rm -rf webapp/node_modules lambda/node_modules infra/node_modules node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@newjersey/feedback-widget": "0.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.9.4",
    "prettier-plugin-jsdoc": "1.8.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "author": {
    "name": "New Jersey Innovation Authority",
    "url": "https://github.com/newjersey"
  },
  "license": "MIT",
  "workspaces": [
    "webapp",
    "lambda",
    "infra"
  ]
}
