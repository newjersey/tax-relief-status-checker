{
  "name": "tax-relief-status-checker",
  "version": "1.0.0",
  "description": "App for NJ residents to check the status of their property tax refund",
  "repository": "github:newjersey/tax-relief-status-checker",
  "homepage": "https://github.com/newjersey/tax-relief-status-checker#readme",
  "bugs": "https://github.com/newjersey/tax-relief-status-checker/issues",
  "scripts": {
    "dev": "cd webapp && vite",
    "build": "cd webapp && tsc -b && vite build",
    "package": "cd lambda && npm run package",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "prettier-plugin-jsdoc": "latest"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "author": {
    "name": "New Jersey State Office of Innovation",
    "url": "https://github.com/newjersey"
  },
  "license": "MIT",
  "workspaces": [
    "webapp",
    "lambda"
  ]
}
