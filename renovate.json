{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "US/Eastern",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    "group:nodeJs"
  ],
  "schedule": ["* 17-23,0-8 * * *", "* * * * 0,6"],
  "automergeSchedule": ["* 9-13 * * 1-5"],
  "ignorePaths": [],
  "labels": ["renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "description": "Github actions don't follow npm semantic versioning. Many actions just have a single version number that does not indicate a breaking change. They also affect the Github Actions themselves, and so the actions should fail if a major version bump breaks something."
    },
    {
      "matchPackageNames": ["@newjersey/feedback-widget"],
      "enabled": false,
      "description": "Pinned to 0.6.0 until accessibility false error is fixed https://github.com/org-njdhs-mahs/doula-medicaid/pull/497"
    },
    {
      "matchPackagePrefixes": ["eslint", "@eslint/js"],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": ["typescript-eslint"],
      "matchPackagePrefixes": ["@typescript-eslint/"],
      "groupName": "typescript-eslint"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    }
  ]
}
